# Copy to .env and set the endpoint and chain ID confirmed for your environment.
# Whitechain's published testnet references currently conflict; do not guess.
ORBIS_RPC_URL=
ORBIS_CHAIN_ID=
ORBIS_NETWORK_NAME=
ORBIS_NETWORK_ENVIRONMENT=
ORBIS_PROVIDER_NAME=
# PostgreSQL is the authoritative persistence target. Apply migrations at CLI startup.
ORBIS_DATABASE_URL=postgresql://orbis_app:CHANGE_ME@127.0.0.1:5432/orbis_dev
ORBIS_TEST_DATABASE_URL=postgresql://orbis_app:CHANGE_ME@127.0.0.1:5432/orbis_test
# Optional lightweight local adapter for development only: sqlite:///./data/orbis.sqlite3
# Legacy SQLite path is retained for direct SqliteStore use; the CLI uses DATABASE_URL.
ORBIS_DATABASE_PATH=./data/orbis.sqlite3
ORBIS_START_BLOCK=
ORBIS_CONFIRMATION_DEPTH=12
ORBIS_RPC_TIMEOUT_SECONDS=15
ORBIS_RPC_MAX_RETRIES=4
ORBIS_BATCH_SIZE=10
